# ── Supabase (Project Settings → API) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Paystack (Settings → API Keys & Webhooks, use the TEST keys) ──
VITE_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
# Server only
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Public URL of the site, used for the Paystack callback (no trailing slash)
SITE_URL=http://localhost:8080

# Blog emails to the email list (Admin → Blog → Email to list), sent through Gmail.
# Use a Google app password (myaccount.google.com/apppasswords), not the normal password.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=
